# Server-only. Do not put real keys in this file.
# Copy to .env.local for local development, and add the same names in Vercel
# for Production and Preview.

# CRM is the lead store. Use the production CRM hostname in Preview and Production.
CRM_API_BASE_URL=https://crm.proppact.co.in
CRM_WEBSITE_LEAD_API_KEY=same-value-as-the-crm-WEBSITE_LEAD_API_KEY

NEXT_PUBLIC_SITE_URL=https://proppact.co.in

